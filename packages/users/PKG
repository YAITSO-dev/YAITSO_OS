NAME=users
VERSION=0.3.1
ARCH=x86_64
DESC="Управление пользователями"
DEPENDS=base
BUILD_SYSTEM=copy
BUILD='
mkdir -p "$STAGE/usr/bin" "$STAGE/usr/sbin"
install -m 755 "$DIST_DIR/users/useradd" "$STAGE/usr/sbin/useradd"
install -m 755 "$DIST_DIR/users/userdel" "$STAGE/usr/sbin/userdel"
install -m 755 "$DIST_DIR/users/passwd"  "$STAGE/usr/bin/passwd"
install -m 755 "$DIST_DIR/users/su"      "$STAGE/usr/bin/su"
install -m 755 "$DIST_DIR/users/sudo"    "$STAGE/usr/bin/sudo"
'
