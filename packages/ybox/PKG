NAME=ybox
VERSION=0.3.1
ARCH=x86_64
DESC="Coreutils Yaitso OS"
DEPENDS=base
BUILD_SYSTEM=copy
BUILD='
mkdir -p "$STAGE/usr/bin"
install -m 755 "$DIST_DIR/ybox/ybox" "$STAGE/usr/bin/ybox"
for c in true false yes basename dirname mkdir rmdir rm cp mv ln chmod chown sync hostname uptime reboot poweroff; do
    ln -sf ybox "$STAGE/usr/bin/$c"
done
'
