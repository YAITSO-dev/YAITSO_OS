NAME=yat
VERSION=0.3.1
ARCH=x86_64
DESC="Пакетный менеджер Yaitso OS"
DEPENDS=base
BUILD_SYSTEM=copy
BUILD='
mkdir -p "$STAGE/usr/bin"
install -m 755 "$DIST_DIR/yat/yat" "$STAGE/usr/bin/yat"
install -m 755 "$DIST_DIR/yat/yat-keygen" "$STAGE/usr/bin/yat-keygen"
install -m 755 "$DIST_DIR/yat/yat-sign" "$STAGE/usr/bin/yat-sign"
'
